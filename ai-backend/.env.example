# ============================================
# D-Lite AI Backend — Environment Variables
# Copy this to .env and fill in values
# ============================================

ENV=development
PORT=5070

# OpenRouter (AI chat) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=gpt-4o-mini

# Deepgram (TTS + STT) — https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_key_here
DEEPGRAM_TTS_VOICE=alloy
DEEPGRAM_TTS_MODEL=gpt-tts
DEEPGRAM_STT_MODEL=nova-2

# CORS — comma-separated allowed origins (required for browser access)
ALLOWED_ORIGINS=https://d-lite-live.vercel.app
